# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# O site funciona sem nenhuma destas variáveis.

# URL pública do site (usada em metadados, sitemap e Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase — configuração PÚBLICA do app web (próxima etapa).
# Console do Firebase → Configurações do projeto → Seus apps → App da Web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary — fotos das criações (cloudinary.com → Settings → API Keys).
# Cloud name e API key podem ser públicos; o secret é SÓ do servidor.
# Na Vercel, marque CLOUDINARY_API_SECRET como "Sensitive".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# UID do administrador no Firebase Authentication (o /admin mostra após o login).
# O servidor só assina envios de fotos para este UID.
ADMIN_UID=

# Credenciais de servidor (Admin SDK), se um dia forem necessárias:
# NUNCA com o prefixo NEXT_PUBLIC_ e nunca em arquivo versionado.
# Cadastrar apenas nas variáveis de ambiente da Vercel.
