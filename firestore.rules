rules_version = '2';

// Regras do Firestore da Engenhices.
// Publicar no console: Firestore → Regras → colar este arquivo → Publicar.
// (Ou, com a CLI do Firebase: firebase deploy --only firestore:rules)

service cloud.firestore {
  match /databases/{database}/documents {

    // Único administrador, identificado pelo UID do Firebase Authentication
    // (o /admin mostra o UID de quem entrou). O UID não é segredo nem dado
    // pessoal; por isso fica aqui, num repositório público, no lugar do e-mail.
    function isAdmin() {
      return request.auth != null && request.auth.uid == '585cpcqio5Y3f3WXYRyZYk84VK93';
    }

    function urlOuNulo(valor) {
      return valor == null || (valor is string && valor.size() <= 500);
    }

    function criacaoValida(d, slug) {
      return d.keys().hasOnly([
          'title', 'slug', 'description', 'images', 'category', 'featured',
          'status', 'youtubeUrl', 'tiktokUrl', 'mercadoLivreUrl', 'customizable',
          'createdAt', 'updatedAt'
        ])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.slug == slug && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && slug.size() <= 80
        && d.description is string && d.description.size() <= 2000
        && d.images is list && d.images.size() <= 12
        && d.category in ['utilidades', 'organizacao', 'mecanismos', 'ferramentas', 'decoracao', 'prototipos']
        && d.featured is bool
        && d.status in ['rascunho', 'publicado', 'arquivado']
        && urlOuNulo(d.youtubeUrl)
        && urlOuNulo(d.tiktokUrl)
        && urlOuNulo(d.mercadoLivreUrl)
        && (!('customizable' in d) || d.customizable is bool)
        && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }

    // Criações: o id do documento é o slug.
    // O público lê só o que foi publicado ou arquivado; rascunhos só o admin vê.
    match /criacoes/{slug} {
      allow read: if isAdmin() || resource.data.status in ['publicado', 'arquivado'];
      allow create: if isAdmin()
        && criacaoValida(request.resource.data, slug)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && criacaoValida(request.resource.data, slug)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    function registroValido(d, slug) {
      return d.keys().hasOnly([
          'title', 'slug', 'type', 'summary', 'body', 'images', 'youtubeUrl', 'tiktokUrl',
          'creationSlug', 'modelUrl', 'status', 'createdAt', 'updatedAt'
        ])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.slug == slug && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && slug.size() <= 80
        && d.type in ['experimento', 'prototipo', 'teste', 'erro', 'melhoria', 'resultado', 'bastidores', 'projeto']
        && d.summary is string && d.summary.size() <= 300
        && d.body is string && d.body.size() <= 10000
        && d.images is list && d.images.size() <= 12
        && urlOuNulo(d.youtubeUrl)
        && urlOuNulo(d.tiktokUrl)
        && (d.creationSlug == null || (d.creationSlug is string && d.creationSlug.size() <= 80))
        && urlOuNulo(d.modelUrl)
        && d.status in ['rascunho', 'publicado']
        && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }

    // Registros do Laboratório: o id do documento é o slug. Guardam os vídeos
    // de processo; a página de uma criação mostra os registros associados.
    match /laboratorio/{slug} {
      allow read: if isAdmin() || resource.data.status == 'publicado';
      allow create: if isAdmin()
        && registroValido(request.resource.data, slug)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && registroValido(request.resource.data, slug)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    function textoEntre(valor, minimo, maximo) {
      return valor is string && valor.size() >= minimo && valor.size() <= maximo;
    }

    // Pedidos de orçamento. Só o servidor do site cria (ele envia a chave
    // guardada em privado/servidor, documento que ninguém lê de fora; o get()
    // das regras enxerga). Só o admin lê, muda a situação ou apaga.
    match /encomendas/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'nome', 'contato', 'descricao', 'finalidade', 'medidas', 'observacoes',
            'linkArquivo', 'fotos', 'arquivo', 'status', 'chave', 'createdAt', 'updatedAt'
          ])
        && request.resource.data.chave
          == get(/databases/$(database)/documents/privado/servidor).data.chave
        && textoEntre(request.resource.data.nome, 2, 100)
        && textoEntre(request.resource.data.contato, 5, 150)
        && textoEntre(request.resource.data.descricao, 20, 3000)
        && textoEntre(request.resource.data.finalidade, 3, 500)
        && textoEntre(request.resource.data.medidas, 0, 300)
        && textoEntre(request.resource.data.observacoes, 0, 1500)
        && textoEntre(request.resource.data.linkArquivo, 0, 500)
        && request.resource.data.fotos is list && request.resource.data.fotos.size() <= 3
        && (request.resource.data.arquivo == null || request.resource.data.arquivo is map)
        && request.resource.data.status == 'nova'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['nova', 'em-analise', 'orcamento-enviado', 'concluida', 'recusada']
        && request.resource.data.updatedAt == request.time;
    }

    // Todo o resto fica fechado (inclusive privado/servidor).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
